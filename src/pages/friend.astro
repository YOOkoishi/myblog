---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
---

<BaseLayout title="Friends">
  <MainCard
    title="Friends "
    description="A collection of links to friends."
    textOverlay="FRIENDS"
    infoIcon="lucide:link"
  >
    <div class="space-y-10">
      <!-- Friends Section -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:users" class="w-6 h-6 text-primary" />
          <span>Friends</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <FriendCard
            name="SixdayC"
            avatar="https://github.com/sixday-C.png"
            description=""
            url="https://www.sixdayc.top/"
            type="friend"
          />
          <FriendCard
            name="sazikk"
            avatar="https://github.com/sazikk.png"
            description=""
            url="https://sazikk.top/"
            type="friend"
          />
          <FriendCard
            name="Kevin"
